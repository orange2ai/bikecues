#!/bin/bash
# pre-push 钩子：推送前强制跑冒烟测试
# 启用：git config core.hooksPath scripts/git-hooks
# 紧急跳过：COUCOU_SKIP_SMOKE=1 git push（原因必须写进提交信息）
if [ "${COUCOU_SKIP_SMOKE:-0}" = "1" ]; then
  echo "[pre-push] COUCOU_SKIP_SMOKE=1，跳过冒烟测试（紧急通道，原因需写入提交信息）"
  exit 0
fi
DIR="$(cd "$(dirname "$0")/../.." && pwd)"
exec "$DIR/scripts/smoke.sh"
